{
  "name": "demoex",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^3.1.1",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "^4.15.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9.9.6",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5",
    "cds-plugin-ui5": "^0.17.0"
  },
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy demoex --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "sapux": [
    "app/project1"
  ]
}
